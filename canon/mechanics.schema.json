{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swigpy/fork120/blob/main/canon/mechanics.schema.json",
  "title": "FORK/120 chapter mechanics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "chapter_id",
    "migration_parent",
    "playable_rounds",
    "stasis_limit",
    "clocks",
    "ledger_baseline"
  ],
  "properties": {
    "version": { "const": 1 },
    "chapter_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "migration_parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "state_commit", "activation"],
      "properties": {
        "state_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[0-9]{3}$" },
        "state_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "activation": { "type": "string", "pattern": "^post:[1-9][0-9]*$" }
      }
    },
    "playable_rounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last", "terminal_state_round"],
      "properties": {
        "first": { "type": "integer", "minimum": 0 },
        "last": { "type": "integer", "minimum": 0 },
        "terminal_state_round": { "type": "integer", "minimum": 1 }
      }
    },
    "stasis_limit": { "type": "integer", "minimum": 0 },
    "clocks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "initial_value",
          "maximum",
          "completion_ledger_id",
          "completion_status",
          "requires_new_active_consequence",
          "completion_consequence"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
          "initial_value": { "type": "integer", "minimum": 0 },
          "maximum": { "type": "integer", "minimum": 1 },
          "completion_ledger_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "completion_status": { "enum": ["TRANSFORMED", "RESOLVED"] },
          "requires_new_active_consequence": { "type": "boolean" },
          "completion_consequence": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" }
        }
      }
    },
    "ledger_baseline": { "$ref": "state.schema.json#/$defs/ledgerState" }
  }
}
