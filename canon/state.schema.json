{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swigpy/fork120/blob/main/canon/state.schema.json",
  "title": "FORK/120 candidate state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "state_id",
    "rules_path",
    "bible_path",
    "chapter_id",
    "round",
    "settlement_kind",
    "parent",
    "world",
    "world_word_count",
    "pressure",
    "sources",
    "content_license",
    "created_at"
  ],
  "properties": {
    "version": { "enum": [1, 2, 3] },
    "state_id": { "$ref": "#/$defs/stateId" },
    "rules_path": { "type": "string", "pattern": "^rules/[a-zA-Z0-9._/-]+\\.md$" },
    "mechanics_path": { "type": "string", "pattern": "^world/[a-zA-Z0-9._/-]+\\.json$" },
    "bible_path": { "type": "string", "pattern": "^world/[a-zA-Z0-9._/-]+\\.md$" },
    "chapter_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "round": { "type": "integer", "minimum": 0 },
    "round_title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
    "chapter_status": { "enum": ["ACTIVE", "CLOSED"] },
    "chapter_outcome": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
    "settlement_kind": { "enum": ["GENESIS", "MOVES", "PRESSURE"] },
    "parent": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/parentV1" },
        { "$ref": "#/$defs/parentV2" }
      ]
    },
    "contributors": {
      "type": "array",
      "items": { "$ref": "#/$defs/contributor" }
    },
    "editor_proposals": {
      "type": "array",
      "items": { "$ref": "#/$defs/editorProposal" }
    },
    "continuity_challenges": {
      "type": "array",
      "items": { "$ref": "#/$defs/continuityChallenge" }
    },
    "ineligible_moves": {
      "type": "array",
      "items": { "$ref": "#/$defs/ineligibleMove" }
    },
    "selection": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/selection" }
      ]
    },
    "world": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
    "world_word_count": { "type": "integer", "minimum": 1, "maximum": 120 },
    "clocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/clock" }
    },
    "clock_changes": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/clockChange" }
    },
    "pressure": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
    "applied_pressure": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
    "pressure_effect": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/pressureEffect" }
      ]
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/commentId" }
    },
    "ledger_delta": { "$ref": "#/$defs/ledgerState" },
    "ledger_state": { "$ref": "#/$defs/ledgerState" },
    "ledger_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/ledgerChange" }
    },
    "stasis_reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
    "content_license": { "const": "CC-BY-SA-4.0" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "stateId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[0-9]{3}$" },
    "commentId": { "type": "string", "pattern": "^c[1-9][0-9]*$" },
    "ledgerId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "ledgerStatus": { "enum": ["ACTIVE", "TRANSFORMED", "RESOLVED", "DORMANT"] },
    "parentV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "git_commit", "activation_comment"],
      "properties": {
        "state_id": { "$ref": "#/$defs/stateId" },
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "activation_comment": { "$ref": "#/$defs/commentId" }
      }
    },
    "parentV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "git_commit", "activation"],
      "properties": {
        "state_id": { "$ref": "#/$defs/stateId" },
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "activation": { "type": "string", "pattern": "^(?:comment:c[1-9][0-9]*|post:[1-9][0-9]*)$" }
      }
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "move_id", "incorporated"],
      "properties": {
        "handle": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$" },
        "move_id": { "$ref": "#/$defs/commentId" },
        "incorporated": { "type": "boolean" }
      }
    },
    "editorProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "comment_id", "used"],
      "properties": {
        "handle": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$" },
        "comment_id": { "$ref": "#/$defs/commentId" },
        "used": { "type": "boolean" }
      }
    },
    "continuityChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "comment_id", "disposition", "note"],
      "properties": {
        "handle": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$" },
        "comment_id": { "$ref": "#/$defs/commentId" },
        "disposition": { "enum": ["REPAIRED", "PRESERVED_UNCERTAINTY", "FORKED", "REJECTED"] },
        "note": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" }
      }
    },
    "ineligibleMove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "comment_id", "disposition", "note"],
      "properties": {
        "handle": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$" },
        "comment_id": { "$ref": "#/$defs/commentId" },
        "disposition": {
          "enum": [
            "LATE",
            "WRONG_BASE",
            "MALFORMED",
            "UNLICENSED",
            "UNSAFE",
            "DUPLICATE_CITIZEN",
            "RULE_VIOLATION"
          ]
        },
        "note": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spine", "carries", "hook", "rationale", "exclusions"],
      "properties": {
        "spine": { "$ref": "#/$defs/commentId" },
        "carries": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/commentId" } },
        "hook": { "$ref": "#/$defs/commentId" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["move_id", "reason"],
            "properties": {
              "move_id": { "$ref": "#/$defs/commentId" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" }
            }
          }
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value", "maximum", "completion"],
      "properties": {
        "id": { "$ref": "#/$defs/ledgerId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
        "value": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 1 },
        "completion": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" }
      }
    },
    "clockChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "source", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/ledgerId" },
        "from": { "type": "integer", "minimum": 0 },
        "to": { "type": "integer", "minimum": 1 },
        "source": { "type": "string", "pattern": "^(?:c[1-9][0-9]*|PRESSURE)$" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" }
      }
    },
    "pressureEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "to"],
      "properties": {
        "kind": { "enum": ["CLOCK", "LEDGER"] },
        "target": { "$ref": "#/$defs/ledgerId" },
        "to": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/ledgerStatus" }
          ]
        }
      }
    },
    "ledgerIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ledgerId" }
    },
    "ledgerState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "transformed", "resolved", "dormant"],
      "properties": {
        "active": { "allOf": [{ "$ref": "#/$defs/ledgerIds" }, { "maxItems": 12 }] },
        "transformed": { "$ref": "#/$defs/ledgerIds" },
        "resolved": { "$ref": "#/$defs/ledgerIds" },
        "dormant": { "$ref": "#/$defs/ledgerIds" }
      }
    },
    "ledgerChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "source", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/ledgerId" },
        "from": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/ledgerStatus" }
          ]
        },
        "to": { "$ref": "#/$defs/ledgerStatus" },
        "source": { "type": "string", "pattern": "^(?:c[1-9][0-9]*|PRESSURE|CLOSURE)$" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "enum": [1, 2] } }, "required": ["version"] },
      "then": { "required": ["ledger_delta"] }
    },
    {
      "if": { "properties": { "version": { "enum": [2, 3] } }, "required": ["version"] },
      "then": { "required": ["round_title", "contributors"], "properties": { "round": { "minimum": 1 } } }
    },
    {
      "if": { "properties": { "version": { "const": 3 } }, "required": ["version"] },
      "then": {
        "required": [
          "mechanics_path",
          "chapter_status",
          "chapter_outcome",
          "editor_proposals",
          "continuity_challenges",
          "ineligible_moves",
          "selection",
          "clocks",
          "clock_changes",
          "applied_pressure",
          "pressure_effect",
          "ledger_state",
          "ledger_changes",
          "stasis_reason"
        ]
      }
    },
    {
      "if": { "properties": { "round": { "const": 0 } }, "required": ["round"] },
      "then": {
        "properties": {
          "version": { "const": 1 },
          "settlement_kind": { "const": "GENESIS" },
          "parent": { "type": "null" },
          "sources": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "settlement_kind": { "const": "MOVES" } }, "required": ["settlement_kind"] },
      "then": { "properties": { "sources": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "settlement_kind": { "enum": ["GENESIS", "PRESSURE"] } }, "required": ["settlement_kind"] },
      "then": { "properties": { "sources": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "round": { "minimum": 1 } }, "required": ["round"] },
      "then": { "properties": { "parent": { "type": "object" } } }
    }
  ]
}
