{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swigpy/fork120/blob/main/canon/state.schema.json",
  "title": "FORK/120 candidate state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "state_id",
    "rules_path",
    "bible_path",
    "chapter_id",
    "round",
    "settlement_kind",
    "parent",
    "world",
    "world_word_count",
    "pressure",
    "sources",
    "ledger_delta",
    "content_license",
    "created_at"
  ],
  "properties": {
    "version": { "enum": [1, 2] },
    "state_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[0-9]{3}$"
    },
    "rules_path": {
      "type": "string",
      "pattern": "^rules/[a-zA-Z0-9._/-]+\\.md$"
    },
    "bible_path": {
      "type": "string",
      "pattern": "^world/[a-zA-Z0-9._/-]+\\.md$"
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "settlement_kind": {
      "enum": ["GENESIS", "MOVES", "PRESSURE"]
    },
    "parent": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state_id", "git_commit", "activation_comment"],
          "properties": {
            "state_id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[0-9]{3}$"
            },
            "git_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "activation_comment": {
              "type": "string",
              "pattern": "^c[1-9][0-9]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state_id", "git_commit", "activation"],
          "properties": {
            "state_id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[0-9]{3}$"
            },
            "git_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "activation": {
              "type": "string",
              "pattern": "^(?:comment:c[1-9][0-9]*|post:[1-9][0-9]*)$"
            }
          }
        }
      ]
    },
    "round_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle", "move_id", "incorporated"],
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "move_id": {
            "type": "string",
            "pattern": "^c[1-9][0-9]*$"
          },
          "incorporated": { "type": "boolean" }
        }
      }
    },
    "world": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "world_word_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "pressure": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^c[1-9][0-9]*$"
      }
    },
    "ledger_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "transformed", "resolved", "dormant"],
      "properties": {
        "active": { "$ref": "#/$defs/ledgerIds" },
        "transformed": { "$ref": "#/$defs/ledgerIds" },
        "resolved": { "$ref": "#/$defs/ledgerIds" },
        "dormant": { "$ref": "#/$defs/ledgerIds" }
      }
    },
    "content_license": {
      "const": "CC-BY-SA-4.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "ledgerIds": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": 2 } }, "required": ["version"] },
      "then": {
        "required": ["round_title", "contributors"],
        "properties": { "round": { "minimum": 1 } }
      }
    },
    {
      "if": { "properties": { "round": { "const": 0 } }, "required": ["round"] },
      "then": {
        "properties": {
          "version": { "const": 1 },
          "settlement_kind": { "const": "GENESIS" },
          "parent": { "type": "null" },
          "sources": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "settlement_kind": { "const": "MOVES" } }, "required": ["settlement_kind"] },
      "then": { "properties": { "sources": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "settlement_kind": { "const": "PRESSURE" } }, "required": ["settlement_kind"] },
      "then": { "properties": { "sources": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "settlement_kind": { "const": "GENESIS" } }, "required": ["settlement_kind"] },
      "then": { "properties": { "round": { "const": 0 }, "parent": { "type": "null" } } }
    },
    {
      "if": { "properties": { "round": { "minimum": 1 } }, "required": ["round"] },
      "then": { "properties": { "parent": { "type": "object" } } }
    }
  ]
}
